# Remote dev: chay service truc tiep tren may local (IDE/mvn), noi ha tang tren VPS.
# Copy sang .env.remote (KHONG commit) roi: docker compose --env-file .env.remote ... (neu can)
# hoac export tung bien truoc khi chay service.
VPS_HOST=162.4.177.91

# Ha tang tren VPS (trung voi .env tren VPS, chi dung khi chay service local)
REDIS_HOST=162.4.177.91
KAFKA_BOOTSTRAP_SERVERS=162.4.177.91:9092
ELASTICSEARCH_URIS=http://162.4.177.91:9200
MINIO_ENDPOINT=http://162.4.177.91:9000

# MySQL tren VPS (dat DB_URL tuong ung khi chay tung service local)
DB_URL_AUTH=jdbc:mysql://162.4.177.91:3306/auth_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_URL_USER=jdbc:mysql://162.4.177.91:3306/user_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_URL_PAYMENT=jdbc:mysql://162.4.177.91:3306/payment_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# Postgres tren VPS
DB_URL_CATALOG=jdbc:postgresql://162.4.177.91:5432/catalog_db
DB_URL_INVENTORY=jdbc:postgresql://162.4.177.91:5432/inventory_db
DB_URL_ORDER=jdbc:postgresql://162.4.177.91:5432/order_db
DB_URL_NOTIFICATION=jdbc:postgresql://162.4.177.91:5432/notification_db
DB_URL_PRODUCT=jdbc:postgresql://162.4.177.91:5432/product_db
DB_URL_REVIEW=jdbc:postgresql://162.4.177.91:5432/review_db
DB_URL_ANALYTICS=jdbc:postgresql://162.4.177.91:5432/analytics_db

# Keycloak tren VPS (port public 7080)
KEYCLOAK_JWK_SET_URI=http://162.4.177.91:7080/realms/ecommerce/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://162.4.177.91:7080/realms/ecommerce/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=ecommerce-app

# Eureka + Zipkin tren VPS
EUREKA_SERVER_URL=http://162.4.177.91:8761/eureka/
ZIPKIN_ENDPOINT=http://162.4.177.91:9411/api/v2/spans

# Vi du chay auth-service local noi VPS (PowerShell):
# $env:REDIS_HOST='162.4.177.91'; $env:KAFKA_BOOTSTRAP_SERVERS='162.4.177.91:9092'
# $env:DB_URL='jdbc:mysql://162.4.177.91:3306/auth_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC'
# $env:KEYCLOAK_JWK_SET_URI='http://162.4.177.91:7080/realms/ecommerce/protocol/openid-connect/certs'
# $env:EUREKA_SERVER_URL='http://162.4.177.91:8761/eureka/'
