# Local development only. Copy to .env; do not commit .env.
COMPOSE_PROJECT_NAME=eccommerce
POSTGRES_ADMIN_PASSWORD=local_pg_admin_change_me
MYSQL_ROOT_PASSWORD=local_mysql_admin_change_me
REDIS_PASSWORD=local_redis_change_me
MINIO_ROOT_USER=local_minio_admin
MINIO_ROOT_PASSWORD=local_minio_change_me
KAFKA_EXTERNAL_HOST=localhost
PRODUCT_EVENTS_TOPIC=product-events
PRODUCT_EVENTS_DLT_TOPIC=product-events.DLT
INVENTORY_STOCK_MOVEMENT_EVENTS_TOPIC=inventory-stock-movement-events
INVENTORY_TRANSFER_EVENTS_TOPIC=inventory-transfer-events
INVENTORY_EVENT_OUTBOX_POLL_DELAY_MS=500
INVENTORY_EVENT_OUTBOX_BATCH_SIZE=100
INVENTORY_EVENT_OUTBOX_LEASE=PT3M
INVENTORY_EVENT_OUTBOX_RETENTION=PT720H
INVENTORY_EVENT_INBOX_RETENTION=PT90D
TRACING_SAMPLING_PROBABILITY=0.1
DEPLOYMENT_ENV=local
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local_keycloak_admin_change_me
KEYCLOAK_DB_PASSWORD=local_keycloak_db_change_me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_grafana_change_me
AUTH_DB_PASSWORD=local_auth_change_me
USER_DB_PASSWORD=local_user_change_me
CATALOG_DB_PASSWORD=local_catalog_change_me
INVENTORY_DB_PASSWORD=local_inventory_change_me
ORDER_DB_PASSWORD=local_order_change_me
PAYMENT_DB_PASSWORD=local_payment_change_me
NOTIFICATION_DB_PASSWORD=local_notification_change_me
PRODUCT_DB_PASSWORD=local_product_change_me
REVIEW_DB_PASSWORD=local_review_change_me
ANALYTICS_DB_PASSWORD=local_analytics_change_me
