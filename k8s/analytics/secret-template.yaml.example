# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic analytics-secrets -n ecommerce #     --from-literal=db-password='<ANALYTICS_DB_PASSWORD>' --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: analytics-secrets
  namespace: ecommerce
  labels:
    app: analytics-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME

