# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic user-secrets -n ecommerce \
#     --from-literal=db-password='<USER_DB_PASSWORD>' \
#     --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: user-secrets
  namespace: ecommerce
  labels:
    app: user-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME
