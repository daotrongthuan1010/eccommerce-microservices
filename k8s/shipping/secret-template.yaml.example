# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic shipping-secrets -n ecommerce \
#     --from-literal=db-password='<SHIPPING_DB_PASSWORD>' --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: shipping-secrets
  namespace: ecommerce
  labels:
    app: shipping-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME
