# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic search-secrets -n ecommerce \
#     --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: search-secrets
  namespace: ecommerce
  labels:
    app: search-service
type: Opaque
stringData:
  redis-password: CHANGEME
