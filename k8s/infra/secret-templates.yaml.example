# Template only — DO NOT fill real values, DO NOT `kubectl apply` this file.
# The `.example` suffix is deliberate: it keeps `kubectl apply -k k8s/infra/`
# from creating Secrets with CHANGEME placeholders (same convention as
# k8s/auth/secret-template.yaml.example).
#
# Runtime values come from /opt/eccommerce/.env on the VPS.
# See k8s/infra/README.md section 1 for the exact creation commands.
---
apiVersion: v1
kind: Secret
metadata:
  name: infra-postgres-secrets
  namespace: ecommerce
  labels:
    app: postgres
type: Opaque
stringData:
  postgres-password: CHANGEME # <- POSTGRES_ADMIN_PASSWORD
  keycloak-db-password: CHANGEME # <- KEYCLOAK_DB_PASSWORD
  catalog-db-password: CHANGEME # <- CATALOG_DB_PASSWORD
  inventory-db-password: CHANGEME # <- INVENTORY_DB_PASSWORD
  order-db-password: CHANGEME # <- ORDER_DB_PASSWORD
  notification-db-password: CHANGEME # <- NOTIFICATION_DB_PASSWORD
  product-db-password: CHANGEME # <- PRODUCT_DB_PASSWORD
  review-db-password: CHANGEME # <- REVIEW_DB_PASSWORD
  analytics-db-password: CHANGEME # <- ANALYTICS_DB_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: infra-mysql-secrets
  namespace: ecommerce
  labels:
    app: mysql
type: Opaque
stringData:
  mysql-root-password: CHANGEME # <- MYSQL_ROOT_PASSWORD
  auth-db-password: CHANGEME # <- AUTH_DB_PASSWORD
  user-db-password: CHANGEME # <- USER_DB_PASSWORD
  payment-db-password: CHANGEME # <- PAYMENT_DB_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: infra-redis-secret
  namespace: ecommerce
  labels:
    app: redis
type: Opaque
stringData:
  redis-password: CHANGEME # <- REDIS_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: infra-minio-secrets
  namespace: ecommerce
  labels:
    app: minio
type: Opaque
stringData:
  root-user: CHANGEME # <- MINIO_ROOT_USER
  root-password: CHANGEME # <- MINIO_ROOT_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: infra-keycloak-secrets
  namespace: ecommerce
  labels:
    app: keycloak
type: Opaque
stringData:
  admin-username: CHANGEME # <- KEYCLOAK_ADMIN (default: admin)
  admin-password: CHANGEME # <- KEYCLOAK_ADMIN_PASSWORD
  db-password: CHANGEME # <- KEYCLOAK_DB_PASSWORD (same value as in infra-postgres-secrets)
