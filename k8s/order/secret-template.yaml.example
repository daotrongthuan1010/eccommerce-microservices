# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic order-secrets -n ecommerce #     --from-literal=db-password='<ORDER_DB_PASSWORD>' --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: order-secrets
  namespace: ecommerce
  labels:
    app: order-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME

