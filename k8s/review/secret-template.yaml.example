# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic review-secrets -n ecommerce #     --from-literal=db-password='<REVIEW_DB_PASSWORD>' --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: review-secrets
  namespace: ecommerce
  labels:
    app: review-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME

