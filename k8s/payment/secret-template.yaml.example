# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic payment-secrets -n ecommerce #     --from-literal=db-password='<PAYMENT_DB_PASSWORD>' --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: payment-secrets
  namespace: ecommerce
  labels:
    app: payment-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME

