# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic inventory-secrets -n ecommerce #     --from-literal=db-password='<INVENTORY_DB_PASSWORD>' --from-literal=redis-password='<REDIS_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: inventory-secrets
  namespace: ecommerce
  labels:
    app: inventory-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME

