# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic file-secrets -n ecommerce \
#     --from-literal=minio-access-key='<MINIO_USER>' \
#     --from-literal=minio-secret-key='<MINIO_PASSWORD>'
apiVersion: v1
kind: Secret
metadata:
  name: file-secrets
  namespace: ecommerce
  labels:
    app: file-service
type: Opaque
stringData:
  minio-access-key: CHANGEME
  minio-secret-key: CHANGEME
