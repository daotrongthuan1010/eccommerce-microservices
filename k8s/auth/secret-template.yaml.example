# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic auth-secrets -n ecommerce \
#     --from-literal=db-password='<AUTH_DB_PASSWORD>' \
#     --from-literal=redis-password='<REDIS_PASSWORD>' \
#     --from-literal=iam-internal-token='<RANDOM_32B>' \
#     --from-literal=keycloak-admin-client-secret='<KC_ADMIN_SECRET>'
# iam-internal-token: shared secret voi api-gateway (X-Internal-Token). De trong = tat kenh secret.
# keycloak-admin-client-secret: de trong = tat register/forgot/change-password (501).
apiVersion: v1
kind: Secret
metadata:
  name: auth-secrets
  namespace: ecommerce
  labels:
    app: auth-service
type: Opaque
stringData:
  db-password: CHANGEME
  redis-password: CHANGEME
  iam-internal-token: CHANGEME
  keycloak-admin-client-secret: CHANGEME
