# Template only — DO NOT fill real values. Create at rollout time with:
#   kubectl create secret generic gateway-secrets -n ecommerce \
#     --from-literal=iam-internal-token='<GIONG_AUTH_IAM_INTERNAL_TOKEN>'
# Phai GIONG iam-internal-token cua auth-secrets. De trong = enrichment that bai nhe (403 -> skip).
apiVersion: v1
kind: Secret
metadata:
  name: gateway-secrets
  namespace: ecommerce
  labels:
    app: api-gateway
type: Opaque
stringData:
  iam-internal-token: CHANGEME
