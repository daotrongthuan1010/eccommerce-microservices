# Template only. Inject values from secret manager; do not commit a populated Secret.
apiVersion: v1
kind: Secret
metadata:
  name: inventory-offsite-backup-secrets
  namespace: ecommerce
type: Opaque
stringData:
  PGPASSWORD: REPLACE_WITH_INVENTORY_DATABASE_PASSWORD
  BACKUP_S3_ACCESS_KEY: REPLACE_WITH_PREFIX_SCOPED_ACCESS_KEY
  BACKUP_S3_SECRET_KEY: REPLACE_WITH_PREFIX_SCOPED_SECRET_KEY
