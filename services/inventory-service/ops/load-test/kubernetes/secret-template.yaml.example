# Template staging; thay toàn bộ giá trị trước khi tạo Secret, không commit credential thật.
apiVersion: v1
kind: Secret
metadata:
  name: inventory-load-test-credentials
  namespace: ecommerce-staging
type: Opaque
stringData:
  AUTH_TOKEN_URL: "REPLACE_WITH_STAGING_TOKEN_ENDPOINT"
  AUTH_CLIENT_ID: "REPLACE_WITH_DEDICATED_LOAD_TEST_CLIENT"
  AUTH_CLIENT_SECRET: "REPLACE_WITH_SECRET"
